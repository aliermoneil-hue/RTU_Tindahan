# Copy this file to .env and fill in real values.
# .env is gitignored. This example file is not - never put a real key in here.

# Django
DJANGO_SECRET_KEY=replace-with-a-new-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL per the approved tech stack)
POSTGRES_DB=rtu_tindahan
POSTGRES_USER=rtu_tindahan
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# LLM screening service
LLM_PROVIDER=gemini
LLM_API_KEY=

# Email (account verification and password reset)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
