# Copy this file to .env and fill in real values.
# .env is gitignored. This example file is not - never put a real key in here.
#
# Local development default: SQLite.
# Leave POSTGRES_DB empty and everything just works - no database server
# needed. To use PostgreSQL, set POSTGRES_DB and the values below.

# Django
DJANGO_SECRET_KEY=replace-with-a-new-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL used in verification emails
FRONTEND_URL=http://localhost:5173

# Database
# Empty POSTGRES_DB = SQLite (recommended for local development).
POSTGRES_DB=
# PostgreSQL (set POSTGRES_DB=rtu_tindahan to use it). Use the port your
# PostgreSQL server actually listens on - it is not always 5432.
#   POSTGRES_DB=rtu_tindahan
POSTGRES_USER=rtu_tindahan
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# RTU identity rules
# Appendix B of the SRS still marks the exact format as "to confirm".
RTU_EMAIL_DOMAIN=rtu.edu.ph
RTU_STUDENT_EMAIL_REGEX=^(?P<student_number>\d{4}-\d{6})@rtu\.edu\.ph$

# LLM screening service (used in a later sprint)
LLM_PROVIDER=gemini
LLM_API_KEY=

# Email (account verification and password reset).
#
# EMAIL_MODE picks the transport. Both SMTP modes read the same two
# credentials, so switching between them is a one-line change.
# Full walkthrough, including how to obtain each credential:
# docs/EMAIL-SETUP.md
#
#   console   local development - code printed in the runserver terminal
#   mailtrap  local development - code lands in the Mailtrap sandbox inbox
#   gmail     deployed backend  - real delivery through Gmail SMTP
#
# Local development (default): the 6-digit code appears in the runserver
# window. No account, no network.
EMAIL_MODE=console

# Local development against the Mailtrap sandbox (nothing reaches a real
# inbox, so sign-up can be tested over and over):
#   EMAIL_MODE=mailtrap
#   EMAIL_HOST_USER=<16-character Mailtrap username>
#   EMAIL_HOST_PASSWORD=<16-character Mailtrap password>

# Deployed backend, real inboxes:
#   EMAIL_MODE=gmail
#   EMAIL_HOST_USER=<gmail address that owns the App Password>
#   EMAIL_HOST_PASSWORD=<16-character Google App Password>

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Only set this when the sending account has a verified alias. Otherwise the
# SMTP modes build it from EMAIL_HOST_USER, because Gmail rejects a From
# address that is not the authenticated account.
DEFAULT_FROM_EMAIL=

# Failed-request limits (SE-05)
THROTTLE_LOGIN=5/min
THROTTLE_REGISTER=10/hour
THROTTLE_VERIFY=20/hour

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
